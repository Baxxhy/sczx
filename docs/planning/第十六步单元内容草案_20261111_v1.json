  "lessons": [
    {
      "id": "lesson-equation",
      "data": {
        "title": "等式性质",
        "grade": "七年级",
        "subject": "数学",
        "duration": 35,
        "source": "项目自编、AI辅助整理的一元一次方程单元；非教材摘录或真实教师经验，正式发布前须人工复核",
        "goal": "理解等式两边共同变化的条件，能用同加、同减、同乘和同除以非零数求未知数，并解释每一步。",
        "knowledgeIds": [
          "kp-equality"
        ],
        "prerequisiteIds": [
          "kp-equal",
          "kp-operations",
          "kp-expression"
        ],
        "caseId": "case-balance",
        "caseVersionId": null,
        "blocks": [
          {
            "id": "eq-intro",
            "type": "explanation",
            "title": "相等的两边",
            "content": "等式表示两边的值相等，例如5 = 5。只改变一边通常不能保持相等。先预测两边同时增加相同数量后会怎样。",
            "required": true
          },
          {
            "id": "eq-balance",
            "type": "activity",
            "title": "让天平两边一起变化",
            "content": "天平两边各有5单位。两边同时增加相同的正量，观察结果，再用自己的话解释。此实物类比只展示非负数量。",
            "required": true,
            "activity": {
              "type": "balance",
              "base": 5,
              "step": 1,
              "max": 10
            }
          },
          {
            "id": "eq-add-sub",
            "type": "explanation",
            "title": "同加、同减",
            "content": "若a = b，那么a + c = b + c，a - c = b - c。c可以为正数、负数或零。关键是两边同时进行相同运算。",
            "required": true
          },
          {
            "id": "eq-example-add",
            "type": "example",
            "title": "例题：消去减去的数",
            "content": "x - 3 = 5\n两边同时加3：x - 3 + 3 = 5 + 3\n得到x = 8。把8代回，8 - 3 = 5，成立。",
            "required": true
          },
          {
            "id": "eq-practice",
            "type": "practice",
            "title": "随堂练习",
            "content": "每一步都说明两边进行了什么运算。",
            "questionIds": [
              "eq-practice-add",
              "eq-practice-sub"
            ],
            "required": true
          },
          {
            "id": "eq-mul-div",
            "type": "explanation",
            "title": "同乘、同除的条件",
            "content": "若a = b，则ac = bc。若c ≠ 0，则a / c = b / c。除数不能为零。\n等式两边同乘0虽仍相等，却可能丢失原方程的信息：x = 2乘0得到0 = 0，不能从0 = 0恢复x = 2。解方程时可逆变形必须保留条件。",
            "required": true
          },
          {
            "id": "eq-example-div",
            "type": "example",
            "title": "例题：共同除以非零数",
            "content": "3z = 18，两边同时除以3：z = 6。\nw / 4 = 3，两边同时乘4：w = 12。\n负数也可参与运算：若b / (-3) = 2，则b = -6；用公式表达，不把负重量放到天平上。",
            "required": true
          },
          {
            "id": "eq-check",
            "type": "check",
            "title": "独立检查",
            "content": "独立作答并解释。需要帮助可以先学习当前题，再换新题重新检查。",
            "questionIds": [
              "eq-check-divide",
              "eq-check-multiply"
            ],
            "required": true
          }
        ],
        "questions": [
          {
            "id": "eq-practice-add",
            "kind": "practice",
            "equation": "x - 3 = 5",
            "prompt": "两边同时加3，x等于多少？",
            "answer": "8",
            "hint": "把两边都写成加3后的算式。",
            "explanation": "x - 3 + 3 = 5 + 3，所以x = 8。",
            "type": "expression",
            "knowledgeIds": [
              "kp-equality"
            ],
            "feedback": [
              {
                "answer": "5",
                "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
              }
            ]
          },
          {
            "id": "eq-practice-sub",
            "kind": "practice",
            "equation": "y + 4 = 11",
            "prompt": "两边同时减4，y等于多少？",
            "answer": "7",
            "hint": "只减左边会破坏相等关系。",
            "explanation": "y + 4 - 4 = 11 - 4，所以y = 7。",
            "type": "expression",
            "knowledgeIds": [
              "kp-equality"
            ],
            "feedback": [
              {
                "answer": "5",
                "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
              }
            ]
          },
          {
            "id": "eq-check-divide",
            "kind": "check",
            "equation": "3z = 18",
            "prompt": "求z，并解释两边为什么可以同时除以3。",
            "answer": "6",
            "hint": "3不等于0，两边同除以3。",
            "explanation": "3z ÷ 3 = 18 ÷ 3，所以z = 6。",
            "type": "expression",
            "knowledgeIds": [
              "kp-equality"
            ],
            "feedback": [
              {
                "answer": "5",
                "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
              }
            ]
          },
          {
            "id": "eq-check-multiply",
            "kind": "check",
            "equation": "w / 4 = 3",
            "prompt": "求w，并写出两边共同进行的运算。",
            "answer": "12",
            "hint": "两边同时乘4。",
            "explanation": "(w / 4) × 4 = 3 × 4，所以w = 12。",
            "type": "expression",
            "knowledgeIds": [
              "kp-equality"
            ],
            "feedback": [
              {
                "answer": "5",
                "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
              }
            ]
          },
          {
            "id": "eq-new-combine",
            "kind": "replacement",
            "equation": "2(a - 1) = 10",
            "prompt": "先使a - 1单独在一边，再求a。",
            "answer": "6",
            "hint": "先两边除以2，再两边加1。",
            "explanation": "a - 1 = 5，所以a = 6。",
            "type": "expression",
            "knowledgeIds": [
              "kp-equality"
            ],
            "feedback": [
              {
                "answer": "5",
                "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
              }
            ]
          },
          {
            "id": "eq-new-negative",
            "kind": "replacement",
            "equation": "b / (-3) = 2",
            "prompt": "求b，说明两边共同进行的运算。",
            "answer": "-6",
            "hint": "两边同时乘-3，负数关系用公式表示。",
            "explanation": "b = 2 × (-3) = -6。",
            "type": "expression",
            "knowledgeIds": [
              "kp-equality"
            ],
            "feedback": [
              {
                "answer": "5",
                "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
              }
            ]
          }
        ],
        "authorship": {
          "kind": "project_authored_ai_assisted",
          "humanReview": "pending"
        }
      }
    },
    {
      "id": "lesson-simple",
      "data": {
        "title": "解简单的一元一次方程",
        "grade": "七年级",
        "subject": "数学",
        "duration": 40,
        "source": "项目自编、AI辅助整理的一元一次方程单元；非教材摘录或真实教师经验，正式发布前须人工复核",
        "authorship": {
          "kind": "project_authored_ai_assisted",
          "humanReview": "pending"
        },
        "goal": "用等式性质解加减、乘除及两步方程，并代回原式验算。",
        "knowledgeIds": [
          "kp-linear-simple"
        ],
        "prerequisiteIds": [
          "kp-equality"
        ],
        "blocks": [
          {
            "id": "simple-explain-0",
            "type": "explanation",
            "title": "确定未知量与运算顺序",
            "content": "一元一次方程含一个未知数，未知数最高次数为1。先看未知项外面做了什么运算，再逆向逐步消去；每一步两边必须同时进行相同运算。",
            "required": true,
            "teacherNote": "先让学生说明依据，再补充规范步骤。"
          },
          {
            "id": "simple-explain-1",
            "type": "explanation",
            "title": "系数与非零条件",
            "content": "解4x=20时，两边同除以4，4不为0。解x/(-3)=4时，两边同乘-3。除数不能为0；为保持方程等价，解题时同乘的数也取非零数。",
            "required": true,
            "teacherNote": "先让学生说明依据，再补充规范步骤。"
          },
          {
            "id": "simple-explain-2",
            "type": "explanation",
            "title": "代回原式",
            "content": "把候选值代入原方程，分别计算左右两边。两边相等才与原式相符；计算相符不替代对推理过程的解释。",
            "required": true,
            "teacherNote": "先让学生说明依据，再补充规范步骤。"
          },
          {
            "id": "simple-example-0",
            "type": "example",
            "title": "例题：先加减后乘除",
            "content": "解2x+3=11：两边减3得2x=8；两边除以非零数2得x=4。验算2×4+3=11。",
            "required": true,
            "teacherQuestion": "这一步对等式两边做了什么？",
            "studentResponse": "写出两边相同的运算并说明条件。",
            "adjustment": "若只改变一边，回到原等式比较。"
          },
          {
            "id": "simple-example-1",
            "type": "example",
            "title": "例题：负数系数",
            "content": "解-2x+5=13：两边减5得-2x=8；两边除以-2得x=-4。验算-2×(-4)+5=13。",
            "required": true,
            "teacherQuestion": "这一步对等式两边做了什么？",
            "studentResponse": "写出两边相同的运算并说明条件。",
            "adjustment": "若只改变一边，回到原等式比较。"
          },
          {
            "id": "simple-practice",
            "type": "practice",
            "title": "活动：比较、求解并验算",
            "content": "先独立写出每一步，再与原式比较；把答案代回左右两边。",
            "questionIds": [
              "simple-p1",
              "simple-p2"
            ],
            "required": true,
            "studentTask": "提交答案和运算解释，保留首次尝试。"
          },
          {
            "id": "simple-check",
            "type": "check",
            "title": "独立检查",
            "content": "不看例题独立作答。若请求帮助，之后换一道未作答新题检查。",
            "questionIds": [
              "simple-c1",
              "simple-c2"
            ],
            "required": true
          }
        ],
        "questions": [
          {
            "id": "simple-p1",
            "kind": "practice",
            "type": "expression",
            "equation": "x+7=12",
            "answer": "5",
            "prompt": "求x，并说明消去7的方法。",
            "hint": "两边同时减7。",
            "explanation": "x=5；5+7=12。",
            "knowledgeIds": [
              "kp-linear-simple"
            ],
            "teacherNote": "核对每一步是否等价，要求代回原式。",
            "requiresTeacherReview": false
          },
          {
            "id": "simple-p2",
            "kind": "practice",
            "type": "expression",
            "equation": "4x=20",
            "answer": "5",
            "prompt": "求x，说明同除条件。",
            "hint": "4不为0，两边同时除以4。",
            "explanation": "x=5；4×5=20。",
            "knowledgeIds": [
              "kp-linear-simple"
            ],
            "teacherNote": "核对每一步是否等价，要求代回原式。",
            "requiresTeacherReview": false
          },
          {
            "id": "simple-c1",
            "kind": "check",
            "type": "expression",
            "equation": "x/(-3)=4",
            "answer": "-12",
            "prompt": "求x并验算。",
            "hint": "两边同时乘-3。",
            "explanation": "x=-12；(-12)/(-3)=4。",
            "knowledgeIds": [
              "kp-linear-simple"
            ],
            "teacherNote": "核对每一步是否等价，要求代回原式。",
            "requiresTeacherReview": false
          },
          {
            "id": "simple-c2",
            "kind": "check",
            "type": "expression",
            "equation": "-2x+5=13",
            "answer": "-4",
            "prompt": "求x，写出两步共同运算。",
            "hint": "先两边减5。",
            "explanation": "-2x=8，x=-4。",
            "knowledgeIds": [
              "kp-linear-simple"
            ],
            "teacherNote": "核对每一步是否等价，要求代回原式。",
            "requiresTeacherReview": false
          },
          {
            "id": "simple-r1",
            "kind": "replacement",
            "type": "expression",
            "equation": "x/5+2=1",
