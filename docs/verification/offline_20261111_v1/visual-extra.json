    "lessonSnapshot": {
      "goal": "理解等式两边共同变化的条件，能用同加、同减、同乘和同除以非零数求未知数，并解释每一步。",
      "grade": "七年级",
      "title": "等式性质",
      "blocks": [
        {
          "id": "eq-intro",
          "type": "explanation",
          "title": "相等的两边",
          "content": "等式表示两边的值相等，例如5 = 5。只改变一边通常不能保持相等。先预测两边同时增加相同数量后会怎样。",
          "required": true
        },
        {
          "id": "eq-balance",
          "type": "activity",
          "title": "让天平两边一起变化",
          "content": "天平两边各有5单位。两边同时增加相同的正量，观察结果，再用自己的话解释。此实物类比只展示非负数量。",
          "activity": {
            "max": 10,
            "base": 5,
            "step": 1,
            "type": "balance"
          },
          "required": true
        },
        {
          "id": "eq-add-sub",
          "type": "explanation",
          "title": "同加、同减",
          "content": "若a = b，那么a + c = b + c，a - c = b - c。c可以为正数、负数或零。关键是两边同时进行相同运算。",
          "required": true
        },
        {
          "id": "eq-example-add",
          "type": "example",
          "title": "例题：消去减去的数",
          "content": "x - 3 = 5\n两边同时加3：x - 3 + 3 = 5 + 3\n得到x = 8。把8代回，8 - 3 = 5，成立。",
          "required": true
        },
        {
          "id": "eq-practice",
          "type": "practice",
          "title": "随堂练习",
          "content": "每一步都说明两边进行了什么运算。",
          "required": true,
          "questionIds": [
            "eq-practice-add",
            "eq-practice-sub"
          ]
        },
        {
          "id": "eq-mul-div",
          "type": "explanation",
          "title": "同乘、同除的条件",
          "content": "若a = b，则ac = bc。若c ≠ 0，则a / c = b / c。除数不能为零。\n等式两边同乘0虽仍相等，却可能丢失原方程的信息：x = 2乘0得到0 = 0，不能从0 = 0恢复x = 2。解方程时可逆变形必须保留条件。",
          "required": true
        },
        {
          "id": "eq-example-div",
          "type": "example",
          "title": "例题：共同除以非零数",
          "content": "3z = 18，两边同时除以3：z = 6。\nw / 4 = 3，两边同时乘4：w = 12。\n负数也可参与运算：若b / (-3) = 2，则b = -6；用公式表达，不把负重量放到天平上。",
          "required": true
        },
        {
          "id": "eq-check",
          "type": "check",
          "title": "独立检查",
          "content": "独立作答并解释。需要帮助可以先学习当前题，再换新题重新检查。",
          "required": true,
          "questionIds": [
            "eq-check-divide",
            "eq-check-multiply"
          ]
        }
      ],
      "caseId": "case-8f4074b5c5f64b059e00f4fe9ca3ef7b",
      "source": "项目自编、AI辅助整理的一元一次方程单元；非教材摘录或真实教师经验，正式发布前须人工复核",
      "unitId": "unit-equation",
      "subject": "数学",
      "version": 1,
      "duration": 35,
      "lessonId": "lesson-equation",
      "questions": [
        {
          "id": "eq-practice-add",
          "hint": "把两边都写成加3后的算式。",
          "kind": "practice",
          "type": "expression",
          "answer": "8",
          "prompt": "两边同时加3，x等于多少？",
          "equation": "x - 3 = 5",
          "feedback": [
            {
              "answer": "5",
              "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
            }
          ],
          "explanation": "x - 3 + 3 = 5 + 3，所以x = 8。",
          "knowledgeIds": [
            "kp-equality"
          ]
        },
        {
          "id": "eq-practice-sub",
          "hint": "只减左边会破坏相等关系。",
          "kind": "practice",
          "type": "expression",
          "answer": "7",
          "prompt": "两边同时减4，y等于多少？",
          "equation": "y + 4 = 11",
          "feedback": [
            {
              "answer": "5",
              "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
            }
          ],
          "explanation": "y + 4 - 4 = 11 - 4，所以y = 7。",
          "knowledgeIds": [
            "kp-equality"
          ]
        },
        {
          "id": "eq-check-divide",
          "hint": "3不等于0，两边同除以3。",
          "kind": "check",
          "type": "expression",
          "answer": "6",
          "prompt": "求z，并解释两边为什么可以同时除以3。",
          "equation": "3z = 18",
          "feedback": [
            {
              "answer": "5",
              "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
            }
          ],
          "explanation": "3z ÷ 3 = 18 ÷ 3，所以z = 6。",
          "knowledgeIds": [
            "kp-equality"
          ]
        },
        {
          "id": "eq-check-multiply",
          "hint": "两边同时乘4。",
          "kind": "check",
          "type": "expression",
          "answer": "12",
          "prompt": "求w，并写出两边共同进行的运算。",
          "equation": "w / 4 = 3",
          "feedback": [
            {
              "answer": "5",
              "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
            }
          ],
          "explanation": "(w / 4) × 4 = 3 × 4，所以w = 12。",
          "knowledgeIds": [
            "kp-equality"
          ]
        },
        {
          "id": "eq-new-combine",
          "hint": "先两边除以2，再两边加1。",
          "kind": "replacement",
          "type": "expression",
          "answer": "6",
          "prompt": "先使a - 1单独在一边，再求a。",
          "equation": "2(a - 1) = 10",
          "feedback": [
            {
              "answer": "5",
              "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
            }
          ],
          "explanation": "a - 1 = 5，所以a = 6。",
          "knowledgeIds": [
            "kp-equality"
          ]
        },
        {
          "id": "eq-new-negative",
          "hint": "两边同时乘-3，负数关系用公式表示。",
          "kind": "replacement",
          "type": "expression",
          "answer": "-6",
          "prompt": "求b，说明两边共同进行的运算。",
          "equation": "b / (-3) = 2",
          "feedback": [
            {
              "answer": "5",
              "message": "检查是否只改变了等式一边；左右两边应进行同一种运算。"
            }
          ],
          "explanation": "b = 2 × (-3) = -6。",
          "knowledgeIds": [
            "kp-equality"
          ]
        }
      ],
