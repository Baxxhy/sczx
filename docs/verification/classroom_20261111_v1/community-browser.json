    "lessonSnapshot": {
      "goal": "用等式性质解加减、乘除及两步方程，并代回原式验算。",
      "grade": "七年级",
      "title": "解简单的一元一次方程",
      "blocks": [
        {
          "id": "simple-explain-0",
          "type": "explanation",
          "title": "确定未知量与运算顺序",
          "content": "一元一次方程含一个未知数，未知数最高次数为1。先看未知项外面做了什么运算，再逆向逐步消去；每一步两边必须同时进行相同运算。",
          "required": true,
          "teacherNote": "先让学生说明依据，再补充规范步骤。"
        },
        {
          "id": "simple-explain-1",
          "type": "explanation",
          "title": "系数与非零条件",
          "content": "解4x=20时，两边同除以4，4不为0。解x/(-3)=4时，两边同乘-3。除数不能为0；为保持方程等价，解题时同乘的数也取非零数。",
          "required": true,
          "teacherNote": "先让学生说明依据，再补充规范步骤。"
        },
        {
          "id": "simple-explain-2",
          "type": "explanation",
          "title": "代回原式",
          "content": "把候选值代入原方程，分别计算左右两边。两边相等才与原式相符；计算相符不替代对推理过程的解释。",
          "required": true,
          "teacherNote": "先让学生说明依据，再补充规范步骤。"
        },
        {
          "id": "simple-example-0",
          "type": "example",
          "title": "例题：先加减后乘除",
          "content": "解2x+3=11：两边减3得2x=8；两边除以非零数2得x=4。验算2×4+3=11。",
          "required": true,
          "adjustment": "若只改变一边，回到原等式比较。",
          "studentResponse": "写出两边相同的运算并说明条件。",
          "teacherQuestion": "这一步对等式两边做了什么？"
        },
        {
          "id": "simple-example-1",
          "type": "example",
          "title": "例题：负数系数",
          "content": "解-2x+5=13：两边减5得-2x=8；两边除以-2得x=-4。验算-2×(-4)+5=13。",
          "required": true,
          "adjustment": "若只改变一边，回到原等式比较。",
          "studentResponse": "写出两边相同的运算并说明条件。",
          "teacherQuestion": "这一步对等式两边做了什么？"
        },
        {
          "id": "simple-practice",
          "type": "practice",
          "title": "活动：比较、求解并验算",
          "content": "先独立写出每一步，再与原式比较；把答案代回左右两边。",
          "required": true,
          "questionIds": [
            "simple-p1",
            "simple-p2"
          ],
          "studentTask": "提交答案和运算解释，保留首次尝试。"
        },
        {
          "id": "simple-check",
          "type": "check",
          "title": "独立检查",
          "content": "不看例题独立作答。若请求帮助，之后换一道未作答新题检查。",
          "required": true,
          "questionIds": [
            "simple-c1",
            "simple-c2"
          ]
        }
      ],
      "caseId": "case-8f4074b5c5f64b059e00f4fe9ca3ef7b",
      "source": "项目自编、AI辅助整理的一元一次方程单元；非教材摘录或真实教师经验，正式发布前须人工复核",
      "unitId": "unit-equation",
      "subject": "数学",
      "version": 1,
      "duration": 40,
      "lessonId": "lesson-simple",
      "questions": [
        {
          "id": "simple-p1",
          "hint": "两边同时减7。",
          "kind": "practice",
          "type": "expression",
          "answer": "5",
          "prompt": "求x，并说明消去7的方法。",
          "equation": "x+7=12",
          "explanation": "x=5；5+7=12。",
          "teacherNote": "核对每一步是否等价，要求代回原式。",
          "knowledgeIds": [
            "kp-linear-simple"
          ],
          "requiresTeacherReview": false
        },
        {
          "id": "simple-p2",
          "hint": "4不为0，两边同时除以4。",
          "kind": "practice",
          "type": "expression",
          "answer": "5",
          "prompt": "求x，说明同除条件。",
          "equation": "4x=20",
          "explanation": "x=5；4×5=20。",
          "teacherNote": "核对每一步是否等价，要求代回原式。",
          "knowledgeIds": [
            "kp-linear-simple"
          ],
          "requiresTeacherReview": false
        },
        {
          "id": "simple-c1",
          "hint": "两边同时乘-3。",
          "kind": "check",
          "type": "expression",
          "answer": "-12",
          "prompt": "求x并验算。",
          "equation": "x/(-3)=4",
          "explanation": "x=-12；(-12)/(-3)=4。",
          "teacherNote": "核对每一步是否等价，要求代回原式。",
          "knowledgeIds": [
            "kp-linear-simple"
          ],
          "requiresTeacherReview": false
        },
        {
          "id": "simple-c2",
          "hint": "先两边减5。",
          "kind": "check",
          "type": "expression",
          "answer": "-4",
          "prompt": "求x，写出两步共同运算。",
          "equation": "-2x+5=13",
          "explanation": "-2x=8，x=-4。",
          "teacherNote": "核对每一步是否等价，要求代回原式。",
          "knowledgeIds": [
            "kp-linear-simple"
          ],
          "requiresTeacherReview": false
        },
        {
          "id": "simple-r1",
          "hint": "先减2，再乘5。",
          "kind": "replacement",
          "type": "expression",
          "answer": "-5",
          "prompt": "求x并代回。",
          "equation": "x/5+2=1",
          "explanation": "x/5=-1，x=-5。",
          "teacherNote": "核对每一步是否等价，要求代回原式。",
          "knowledgeIds": [
            "kp-linear-simple"
          ],
          "requiresTeacherReview": false
        },
        {
          "id": "simple-r2",
          "hint": "先加4，再除以非零数3。",
          "kind": "replacement",
          "type": "expression",
          "answer": "5",
          "prompt": "求x并解释。",
          "equation": "3x-4=11",
          "explanation": "3x=15，x=5。",
          "teacherNote": "核对每一步是否等价，要求代回原式。",
          "knowledgeIds": [
            "kp-linear-simple"
          ],
          "requiresTeacherReview": false
        }
      ],
