# Independent loopback-only staging; no implicit migration.
SCZX_ENV=staging
SCZX_DATABASE_URL=mysql+pymysql://sczx:CHANGE_ME@127.0.0.1:23320/sczx_test_release
SCZX_RELEASE_ROOT=/absolute/persistent/releases/SCZX_COMMIT
SCZX_FRONTEND_DIST=/absolute/persistent/releases/SCZX_COMMIT/frontend/dist
SCZX_RELEASE_PYTHON=/absolute/persistent/runtime/venv/bin/python
SCZX_RELEASE_STATE=/absolute/persistent/staging/process
SCZX_STORAGE_DIR=/absolute/persistent/staging/uploads
SCZX_LOG_DIR=/absolute/persistent/staging/logs
SCZX_BACKUP_DIR=/absolute/persistent/staging/backups
SCZX_RELEASE_HOST=127.0.0.1
SCZX_RELEASE_PORT=8095
SCZX_RELEASE_URL=http://127.0.0.1:8095
SCZX_HEALTH_URL=http://127.0.0.1:8095
SCZX_PUBLIC_URL=https://localhost:9443
SCZX_COOKIE_SECURE=true
SCZX_FORWARDED_ALLOW_IPS=127.0.0.1
SCZX_AUTO_CREATE_SCHEMA=false
SCZX_MODEL_TRANSPORT=codex_cli
SCZX_RUNTIME_PATH=/absolute/persistent/bin:/usr/local/bin:/usr/bin:/bin
SCZX_CODEX_BIN=/absolute/persistent/bin/codex
SCZX_CODEX_HOME=/absolute/private/codex-home
SCZX_CODEX_TIMEOUT_SECONDS=115
