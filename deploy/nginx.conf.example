# Replace the approved domain and existing certificate paths before enabling.
server {
    listen 80;
    server_name YOUR_APPROVED_DOMAIN;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name YOUR_APPROVED_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/YOUR_APPROVED_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_APPROVED_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 25m;
    add_header X-Content-Type-Options nosniff always;
    location = /sw.js {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control "no-cache" always;
    }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 180s;
    }
}
