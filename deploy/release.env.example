# Copy outside Git, chmod 600; use an independent MySQL database.
SCZX_DATABASE_URL=mysql+pymysql://sczx:CHANGE_ME@127.0.0.1:3306/sczx
SCZX_STORAGE_DIR=/absolute/path/sczx-data/uploads
SCZX_FRONTEND_DIST=/absolute/path/sczx/frontend/dist
SCZX_RELEASE_PYTHON=/absolute/path/venv/bin/python
SCZX_RELEASE_STATE=/absolute/path/sczx-data/process
SCZX_RELEASE_HOST=127.0.0.1
SCZX_RELEASE_PORT=8087
SCZX_RELEASE_URL=http://127.0.0.1:8087
SCZX_MODEL_TRANSPORT=codex_cli
SCZX_COOKIE_SECURE=false
SCZX_FACT_TIME_OFFSET_SECONDS=28800
# Set true only behind configured HTTPS. No public domain is assumed.
