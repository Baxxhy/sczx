# Production template only. Copy outside Git; chmod 600. Fill after target approval.
SCZX_ENV=production
SCZX_DATABASE_URL=mysql+pymysql://sczx:CHANGE_ME@127.0.0.1:3306/sczx
SCZX_RELEASE_ROOT=/opt/sczx/releases/SCZX_COMMIT
SCZX_FRONTEND_DIST=/opt/sczx/releases/SCZX_COMMIT/frontend/dist
SCZX_RELEASE_COMMIT=SCZX_FULL_COMMIT_SHA
SCZX_RELEASE_MANIFEST_SHA256=RELEASE_MANIFEST_SHA256
SCZX_RELEASE_BUNDLE=/opt/sczx/releases/SCZX_COMMIT.tar.gz
SCZX_STORAGE_DIR=/var/lib/sczx/uploads
SCZX_RELEASE_PYTHON=/opt/sczx/runtime/venv/bin/python
SCZX_RELEASE_STATE=/var/lib/sczx/process
SCZX_LOG_DIR=/var/log/sczx
SCZX_BACKUP_DIR=/var/backups/sczx
SCZX_RELEASE_HOST=127.0.0.1
SCZX_RELEASE_PORT=8000
SCZX_RELEASE_URL=http://127.0.0.1:8000
SCZX_HEALTH_URL=http://127.0.0.1:8000
SCZX_PUBLIC_URL=https://YOUR_APPROVED_DOMAIN
SCZX_COOKIE_SECURE=true
SCZX_FORWARDED_ALLOW_IPS=127.0.0.1
SCZX_ALLOWED_ORIGINS=
SCZX_AUTO_CREATE_SCHEMA=false
SCZX_MODEL_TRANSPORT=codex_cli
SCZX_RUNTIME_PATH=/usr/local/bin:/usr/bin:/bin
SCZX_CODEX_BIN=/usr/local/bin/codex
SCZX_CODEX_HOME=/var/lib/sczx/codex
SCZX_CODEX_TIMEOUT_SECONDS=115
SCZX_FACT_TIME_OFFSET_SECONDS=28800
SCZX_APPROVAL_FILE=/etc/sczx/approved-change.json
# No automatic deletion of records, images or backups. Review retention manually.
SCZX_DATA_RETENTION=retain
