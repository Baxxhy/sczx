# Local development only. Explicitly initialize an independent test database.
SCZX_ENV=development
SCZX_DATABASE_URL=mysql+pymysql://sczx:CHANGE_ME@127.0.0.1:3306/sczx_test_development
SCZX_STORAGE_DIR=/absolute/path/sczx/backend-business/var/uploads
SCZX_FRONTEND_DIST=/absolute/path/sczx/frontend/dist
SCZX_RELEASE_PYTHON=/absolute/path/venv/bin/python
SCZX_RELEASE_STATE=/absolute/path/sczx/backend-business/var/process
SCZX_RELEASE_HOST=127.0.0.1
SCZX_RELEASE_PORT=8001
SCZX_RELEASE_URL=http://127.0.0.1:8001
SCZX_COOKIE_SECURE=false
SCZX_AUTO_CREATE_SCHEMA=false
SCZX_MODEL_TRANSPORT=codex_cli
