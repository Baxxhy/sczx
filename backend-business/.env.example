SCZX_DATABASE_URL=mysql+pymysql://sczx:CHANGE_ME@127.0.0.1:23317/sczx
SCZX_SESSION_SECRET=replace-with-a-long-random-value
SCZX_COOKIE_SECURE=false
SCZX_STORAGE_DIR=./var/uploads
# Model calls default to Codex CLI: gpt-6-luna, low reasoning.
SCZX_MODEL_TRANSPORT=codex_cli
# Optional CLI executable and isolated configuration directory:
# SCZX_CODEX_BIN=codex
# SCZX_CODEX_HOME=./var/codex
# SCZX_CODEX_INHERIT_PROXY=true
# Legacy HTTP transport is only used when explicitly selected. No automatic fallback.
# Optional: defaults to backend-business/config/model_pool.json
# SCZX_MODEL_CONFIG=./config/model_pool.json
# Set the API key variables referenced by config/model_pool.json in the environment.
SCZX_BOOTSTRAP_ADMIN_USERNAME=admin
SCZX_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
SCZX_BOOTSTRAP_TEACHER_USERNAME=teacher
SCZX_BOOTSTRAP_TEACHER_PASSWORD=CHANGE_ME
SCZX_BOOTSTRAP_STUDENT_USERNAME=student
SCZX_BOOTSTRAP_STUDENT_PASSWORD=CHANGE_ME
# Historical DB-generated learning facts were written in Asia/Shanghai.
# Keep this historical basis stable when changing the reader's MySQL session zone.
SCZX_FACT_TIME_OFFSET_SECONDS=28800
